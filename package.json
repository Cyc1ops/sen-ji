{
  "name": "forest-timer",
  "productName": "森记",
  "version": "1.0.0",
  "description": "森林时间统计应用",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:electron && vite build && electron-builder",
    "build:mac": "npm run build:electron && vite build && electron-builder --mac",
    "build:app": "vite build",
    "build:electron": "node build-electron.js",
    "watch:electron": "nodemon --watch electron --ext ts --exec \"node build-electron.js\"",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"npm run watch:electron\" \"wait-on http://localhost:5173 dist-electron/main.js && electron .\"",
    "electron:build": "npm run build:electron && vite build && electron-builder"
  },
  "keywords": [
    "electron",
    "time-tracker",
    "productivity"
  ],
  "author": "cyc1ops",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "framer-motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "esbuild": "^0.19.12",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.forest.timer",
    "productName": "森记",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    }
  }
}
